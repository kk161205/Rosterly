# Copy to .env. This service has NO database connection string on purpose:
# it reads only through the core backend, with each person's own token
# See app/core/config.py.

CORE_BACKEND_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq (console.groq.com). The key lives only in this service.
GROQ_API_KEY=
# Optional — these are the defaults. Each model has its own per-minute token allowance;
# when one is busy the next is tried.
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SPARE=qwen/qwen3.8-27b
# GROQ_MODEL_SMART=openai/gpt-oss-120b

# Questions per person
# AI_RATE_PER_MINUTE=12
# AI_RATE_PER_DAY=300

ENVIRONMENT=development
