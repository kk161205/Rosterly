# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local PostgreSQL: postgresql://rosterly:changeme@localhost:5432/rosterly
# Neon (shared dev/test database, demo data only): postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://rosterly:changeme@localhost:5432/rosterly

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
JWT_SECRET_KEY=changeme-generate-a-real-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Encrypts authenticator-app secrets (required in production). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Rosterly

# --- Email Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@rosterly.example
# Keep false until real SMTP credentials are set above.
EMAIL_DELIVERY_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173
INVITE_TOKEN_EXPIRE_HOURS=72

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- App Settings ---
# production: the app refuses to start on dev defaults (JWT secret, localhost
# CORS/DB/frontend URLs) and stops publishing /docs.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Per-IP limits on login, MFA, refresh, forgot/reset password (kept in Postgres).
AUTH_RATE_LIMITS_ENABLED=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# The timezone that decides "today" for attendance and leave balances.
# ATTENDANCE_TIMEZONE=Asia/Kolkata

# Behind a proxy (Render): where the real client IP comes from. 0 hops = use the TCP peer (local).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=True-Client-IP
