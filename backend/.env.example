# Copy to .env and fill in real values. Never commit .env — see rules.md §4.

# --- Database ---
POSTGRES_USER=rosterly
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rosterly
DATABASE_URL=postgresql://rosterly:changeme@postgres:5432/rosterly

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth (zero-trust session model, see project doc §2) ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (P1 addition — critical notification channel, see project doc §1.19, §6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@rosterly.example

# --- File uploads (project doc §7 rule 8) ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
