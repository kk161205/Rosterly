# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local Docker: postgresql://rosterly:changeme@postgres:5432/rosterly
# Neon Cloud DB: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://rosterly:changeme@localhost:5432/rosterly

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
JWT_SECRET_KEY=changeme-generate-a-real-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@rosterly.example

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg

# --- App Settings ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
